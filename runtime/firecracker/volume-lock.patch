+            .map_err(|x| VirtioBlockError::BackingFile(x, disk_image_path.to_string()))?;
+        // The VMM owns this descriptor for the entire backing-file lifetime.
+        // Worker/jailer crashes must not release the writable-volume lock.
+        // Read-only images may be shared, but may not overlap a writer.
+        let operation = if is_disk_read_only { libc::LOCK_SH } else { libc::LOCK_EX };
+        // SAFETY: the live File owns a valid fd; flock does not take pointers.
+        if unsafe { libc::flock(file.as_raw_fd(), operation | libc::LOCK_NB) } != 0 {
+            return Err(VirtioBlockError::BackingFile(
+                std::io::Error::last_os_error(), disk_image_path.to_string(),
+            ));
+        }
+        Ok(file)
     }
 
