+        let writer = DiskProperties::open_file(path, false).unwrap();
+        assert!(DiskProperties::open_file(path, false).is_err());
+        assert!(DiskProperties::open_file(path, true).is_err());
+        // Renaming or using another hard link does not evade the inode lock.
+        let alias = path.to_owned() + ".alias";
+        std::fs::hard_link(path, &alias).unwrap();
+        assert!(DiskProperties::open_file(&alias, false).is_err());
+        drop(writer);
+        let next_generation = DiskProperties::open_file(&alias, false).unwrap();
+        drop(next_generation);
+        std::fs::remove_file(alias).unwrap();
+    }
