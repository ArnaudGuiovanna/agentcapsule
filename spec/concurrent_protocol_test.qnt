module concurrentProtocolTests {
  import concurrentProtocol(AGENTS=Set(0,1,2), ROUTES=Map(0->(0,1),1->(2,1),2->(2,0),3->(0,2)),
    MANUAL=Set(), LOCKS=true, WAIT_ALL=true, SERIALIZE=true, DEDUP=true,
    CALLER_GUARD=true, SCOPED_FENCES=true, FIFO=true, MAX_GEN=2).* from "./concurrent_protocol"
  action submit(r: int): bool = receive(0,r,SubmitCall,sender(r)).then(admit(0)).then(commitCall(0))
  action deliver(w: int, e: EventId): bool = claim(w,e).then(authorize(w)).then(beginEffect(w)).then(commitEffect(w)).then(acknowledge(w))
  action barrierEverywhere(p: Subject): bool = fenceStore(0,p).then(recordFence(0,p))
    .then(fenceStore(1,p)).then(recordFence(1,p)).then(fenceStore(2,p)).then(recordFence(2,p))
  action retireStopped(a: int): bool = retireBoot(a).then(observeStopped(a))
  action restart(a: int, restricted: bool): bool = retireStopped(a).then(bootVM(a,restricted))
    .then(launchBoot(a)).then(confirmBoot(a)).then(publishBoot(a))
  action fourRequests = init.then(submit(0)).then(submit(1)).then(submit(2)).then(submit(3))

  run deletionAcrossFourRequestsTest = fourRequests
    .then(claim(0,(0,0))).then(authorize(0)).then(beginEffect(0))
    .then(claim(1,(2,0))).then(authorize(1)).then(beginEffect(1))
    .then(requestDelete(1)).expect(safety and busy(s,0) and busy(s,1))
    .then(commitEffect(0)).then(acknowledge(0)).then(commitEffect(1)).then(acknowledge(1))
    .then(barrierEverywhere(AgentSubject(1))).then(commitDelete(1))
    .expect(safety and s.requests.get(0).phase == Canceled and s.requests.get(1).phase == Canceled
      and s.requests.get(2).phase == Processing and s.requests.get(3).phase == Delivering)
    .then(deliver(0,(0,2))).expect(safety and s.requests.get(0).notified)
    .then(receive(0,2,ReplyCall,0)).then(admit(0)).then(commitCall(0))
    .expect(safety and s.requests.get(2).phase == Replied)

  run requestLocalExpirationTest = init.then(submit(0)).then(submit(1))
    .then(closeRequest(0,ExpireRequest)).then(barrierEverywhere(RequestSubject(0))).then(commitClose(0))
    .then(deliver(0,(1,0)))
    .expect(safety and s.requests.get(0).phase == Expired and s.requests.get(1).phase == Processing)
    .then(deliver(0,(0,2))).expect(safety and s.requests.get(0).notified)

  run terminalStateSurvivesLateReplyTest = init.then(submit(0)).then(deliver(0,(0,0)))
    .then(receive(0,0,ReplyCall,1)).then(closeRequest(0,CancelRequest))
    .then(barrierEverywhere(RequestSubject(0))).then(commitClose(0))
    .expect(safety and s.requests.get(0).phase == Canceled).then(admit(0).fail())

  run sharedMandateLockTest = init.then(receive(0,0,SubmitCall,0)).then(receive(1,3,SubmitCall,0))
    .then(admit(0)).expect(safety).then(admit(1).fail())
  run sharedMandateConservationTest = init.then(receive(0,0,SubmitCall,0)).then(receive(1,3,SubmitCall,0))
    .then(admit(0)).then(commitCall(0)).then(admit(1)).then(commitCall(1))
    .expect(safety and s.mandates.get(0).remaining == 0 and s.requests.get(0).accepted and s.requests.get(3).accepted)
  run expirationDuringAdmissionTest = init.then(receive(0,0,SubmitCall,0)).then(admit(0))
    .then(expireMandate(0)).expect(safety).then(commitCall(0).fail())
  run foreignMandateTest = init.then(receive(0,0,SubmitCall,2)).expect(safety).then(admit(0).fail())

  run fifoAcrossRequestsTest = init.then(submit(1)).then(submit(0))
    .expect(safety and isHead(s,(1,0))).then(claim(0,(0,0)).fail())
  run fifoAfterFirstAckTest = init.then(submit(1)).then(submit(0)).then(deliver(0,(1,0)))
    .then(deliver(0,(0,0))).expect(safety and s.effects.get((0,0)) == 1 and s.effects.get((1,0)) == 1)

  run duplicateAfterLostAckTest = init.then(submit(0)).then(claim(0,(0,0))).then(authorize(0))
    .then(beginEffect(0)).then(commitEffect(0)).then(expireLease((0,0)))
    .then(deliver(1,(0,0))).expect(safety and s.effects.get((0,0)) == 1)
    .then(acknowledge(0).fail())
  run duplicateAcrossGenerationTest = init.then(submit(0)).then(claim(0,(0,0))).then(authorize(0))
    .then(beginEffect(0)).then(commitEffect(0)).then(loseRPC(0)).then(stopVM(1)).then(restart(1,false))
    .then(expireLease((0,0))).then(deliver(1,(0,0)))
    .expect(safety and s.effects.get((0,0)) == 1 and s.agents.get(1).generation == 2)
  run oldChannelTest = init.then(submit(0)).then(claim(0,(0,0))).then(authorize(0))
    .then(stopVM(1)).then(restart(1,false)).expect(safety).then(beginEffect(0).fail())
  run oldCallerTest = init.then(receive(0,0,SubmitCall,0)).then(stopVM(0)).then(restart(0,false))
    .expect(safety).then(admit(0).fail())
  run admittedPhysicalDeathTest = init.then(receive(0,0,SubmitCall,0)).then(admit(0))
    .then(stopVM(0)).then(retireBoot(0)).then(commitCall(0)).then(observeStopped(0))
    .expect(safety and s.requests.get(0).phase == Delivering and not(s.agents.get(0).alive))
  run authorityLockTest = init.then(receive(0,0,SubmitCall,0)).then(admit(0))
    .then(stopVM(0)).then(retireBoot(0)).expect(safety).then(observeStopped(0).fail())

  run writerBlocksFenceTest = init.then(submit(0)).then(claim(0,(0,0))).then(authorize(0))
    .then(beginEffect(0)).then(requestDelete(1)).expect(safety).then(fenceStore(1,AgentSubject(1)).fail())
  run abortedWriterThenFenceTest = init.then(submit(0)).then(claim(0,(0,0))).then(authorize(0))
    .then(beginEffect(0)).then(requestDelete(1)).then(stopVM(1)).then(restart(1,true))
    .then(barrierEverywhere(AgentSubject(1))).then(commitDelete(1))
    .expect(safety and s.effects.get((0,0)) == 0 and s.requests.get(0).phase == Canceled)
  run fencedDuplicateRefusedTest = init.then(submit(0)).then(deliver(0,(0,0)))
    .then(receive(0,0,ReplyCall,1)).then(admit(0)).then(commitCall(0))
    .then(claim(0,(0,1))).then(authorize(0)).then(beginEffect(0)).then(commitEffect(0)).then(loseRPC(0))
    .then(expireLease((0,1))).then(claim(1,(0,1))).then(authorize(1))
    .then(requestDelete(1)).then(barrierEverywhere(AgentSubject(1))).then(commitDelete(1))
    .expect(safety and s.requests.get(0).phase == Replied and s.effects.get((0,1)) == 1)
    .then(beginEffect(1).fail())
  run statusAfterReplyRevocationTest = init.then(submit(0)).then(deliver(0,(0,0)))
    .then(receive(0,0,ReplyCall,1)).then(admit(0)).then(commitCall(0))
    .then(requestDelete(1)).then(barrierEverywhere(AgentSubject(1))).then(commitDelete(1))
    .then(deliver(0,(0,2))).expect(safety and s.requests.get(0).phase == Replied and s.requests.get(0).notified)

  run retiredNotificationTest = init.then(submit(0)).then(closeRequest(0,FailRequest))
    .then(barrierEverywhere(RequestSubject(0))).then(commitClose(0))
    .then(claim(0,(0,2))).then(authorize(0)).then(loseRPC(0)).then(expireLease((0,2)))
    .then(claim(0,(0,2))).then(authorize(0)).then(loseRPC(0)).then(expireLease((0,2)))
    .then(beginRetire((0,2))).then(fenceStore(0,EventSubject((0,2)))).then(recordFence(0,EventSubject((0,2))))
    .then(retire((0,2))).expect(safety and s.events.get((0,2)).phase == DeadEvent and not(s.requests.get(0).notified))
  run sealAndFutureBarrierTest = init.then(requestDelete(1)).then(barrierEverywhere(AgentSubject(1)))
    .then(commitDelete(1)).then(stopVM(1)).then(retireStopped(1)).then(sealStore(1))
    .then(submit(2)).then(closeRequest(2,CancelRequest)).then(barrierEverywhere(RequestSubject(2)))
    .then(commitClose(2)).expect(safety and s.agents.get(1).sealed and s.requests.get(2).phase == Canceled)
    .then(bootVM(1,true).fail())
  run workerCrashRollsBackAdmissionTest = init.then(receive(0,0,SubmitCall,0)).then(admit(0))
    .then(crashWorker).then(recoverWorker).then(submit(0))
    .expect(safety and s.mandates.get(0).remaining == 1)
  run orphanedConfirmedBootTest = init.then(stopVM(0)).then(retireStopped(0)).then(bootVM(0,false))
    .then(launchBoot(0)).then(confirmBoot(0)).then(crashWorker).then(recoverWorker)
    .then(retireBoot(0)).then(observeStopped(0)).expect(safety and s.agents.get(0).placement == Stopped)
  run expiredStartLeaseCleanupTest = init.then(stopVM(0)).then(retireStopped(0)).then(bootVM(0,false))
    .then(launchBoot(0)).then(expireBootLease(0)).then(abandonBoot(0)).then(retireStopped(0))
    .expect(safety and not(s.agents.get(0).alive))
  run publicationAfterStopIntentTest = init.then(stopVM(0)).then(retireStopped(0)).then(bootVM(0,false))
    .then(launchBoot(0)).then(confirmBoot(0)).then(beginStop(0)).then(publishBoot(0))
    .then(receive(0,0,SubmitCall,0)).expect(safety).then(admit(0).fail())
}

module concurrentProtocolManualTests {
  import concurrentProtocol(AGENTS=Set(0,1,2), ROUTES=Map(0->(0,1),1->(2,1),2->(2,0),3->(0,2)),
    MANUAL=Set(1), LOCKS=true, WAIT_ALL=true, SERIALIZE=true, DEDUP=true,
    CALLER_GUARD=true, SCOPED_FENCES=true, FIFO=true, MAX_GEN=2).* from "./concurrent_protocol"
  action submitted = init.then(receive(0,0,SubmitCall,0)).then(admit(0)).then(commitCall(0))
  run manualAcceptTest = submitted.then(receive(0,0,AcceptCall,1)).then(admit(0)).then(commitCall(0))
    .expect(safety and s.requests.get(0).phase == Delivering and s.events.get((0,0)).phase == PendingEvent)
  run manualAcceptWhileSleepingTest = submitted.then(stopVM(1)).then(retireBoot(1)).then(observeStopped(1))
    .then(receive(0,0,AcceptCall,1)).then(admit(0)).then(commitCall(0))
    .expect(safety and s.requests.get(0).phase == Delivering and not(s.agents.get(1).alive))
  run manualDeclineTest = submitted.then(receive(0,0,DeclineCall,1)).then(admit(0)).then(commitCall(0))
    .expect(safety and s.requests.get(0).phase == Declined and s.events.get((0,2)).phase == PendingEvent)
  run closeBlocksConsentTest = submitted.then(receive(0,0,AcceptCall,1)).then(closeRequest(0,ExpireRequest))
    .expect(safety).then(admit(0).fail())
  run abortedAdmissionReleasesLocksTest = submitted.then(receive(0,0,AcceptCall,1)).then(admit(0)).then(abortCall(0))
    .then(closeRequest(0,CancelRequest)).expect(safety and s.requests.get(0).closure == CancelRequest)
}
