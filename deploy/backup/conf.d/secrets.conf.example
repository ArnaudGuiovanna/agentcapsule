# /etc/pgbackrest/conf.d/secrets.conf, owned by postgres, mode 0600. Generate
# each passphrase with `openssl rand -hex 32` and keep a copy OFF the host
# (a password manager): without it, the backups cannot be read. The two
# passphrases are distinct, so that one store's secret opens nothing else.
[global]
repo1-s3-key=<access key of a bucket-scoped credential>
repo1-s3-key-secret=<its secret>
repo1-cipher-pass=<64 hex characters>
repo2-cipher-pass=<64 other hex characters>
