# A base backup of PostgreSQL into both repositories (REC-03): %i is "full"
# or "diff". Each repository gets its own backup, so that either store alone
# restores the database.
[Unit]
Description=Agent Capsule PostgreSQL %i backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/pgbackrest --stanza=agentcapsule --repo=1 --type=%i backup
ExecStart=/usr/bin/pgbackrest --stanza=agentcapsule --repo=2 --type=%i backup
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle

# Confinement (S-06). pgBackRest reads the cluster, talks to PostgreSQL over
# its socket and to both repositories over the network, and writes only its
# log, its spool and its locks. Those locks are in /tmp/pgbackrest (its
# lock-path default) and must be the ones every pgBackRest process of the
# host sees: the other timer's backup, the installer's, archive-push. So no
# PrivateTmp=, and /tmp stays writable.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/tmp -/var/log/pgbackrest -/var/spool/pgbackrest
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# AF_NETLINK: glibc's resolver asks the kernel for the host's addresses when
# it sorts the repositories' addresses.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
