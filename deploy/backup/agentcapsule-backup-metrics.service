# Base-backup freshness for node_exporter's textfile collector (REC-03): the
# newest full and differential backup that each repository holds, read with
# pgbackrest info. It runs as root only to write into node_exporter's
# directory; pgBackRest itself runs as postgres. Started by
# agentcapsule-backup-metrics.timer.
[Unit]
Description=Agent Capsule backup freshness for node_exporter
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/agentcapsule/agentcapsule-backup-metrics.py --textfile-directory=/var/lib/prometheus/node-exporter
TimeoutStartSec=10min
Nice=10
# Switch to postgres for pgBackRest, and write into a directory node_exporter owns.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
