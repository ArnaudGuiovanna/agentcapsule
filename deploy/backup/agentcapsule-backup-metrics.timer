# Base-backup freshness every 15 minutes. The metrics are timestamps, so the
# alerts' ages keep growing if this stops; AgentCapsuleBackupMetricsStale fires
# after an hour without a collection.
[Unit]
Description=Agent Capsule backup freshness every 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
RandomizedDelaySec=1min

[Install]
WantedBy=timers.target
