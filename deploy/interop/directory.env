# AGNTCY Directory API server v1.8.0, private single-host profile.
DIRECTORY_SERVER_LISTEN_ADDRESS=0.0.0.0:8888
DIRECTORY_SERVER_LOGGING_VERBOSE=false
DIRECTORY_LOGGER_LOG_LEVEL=INFO
DIRECTORY_LOGGER_LOG_FORMAT=json

# The server's own authentication needs a SPIFFE Workload API (SPIRE). It stays
# off: the server is reachable only on the internal network, through the
# mutual-TLS edge that admits the control plane's certificate alone.
DIRECTORY_SERVER_AUTHN_ENABLED=false
DIRECTORY_SERVER_AUTHZ_ENABLED=false
DIRECTORY_SERVER_POLICY_ENFORCEMENT_SEARCH=off
DIRECTORY_SERVER_POLICY_ENFORCEMENT_FETCH=off

# Records live in an embedded SQLite database and a local OCI layout. The
# Directory is an index derived from the platform's PostgreSQL, which can
# publish every record again; it holds nothing the platform cannot rebuild.
DIRECTORY_SERVER_DATABASE_TYPE=sqlite
DIRECTORY_SERVER_DATABASE_SQLITE_PATH=/data/dir.db
DIRECTORY_SERVER_STORE_PROVIDER=oci
DIRECTORY_SERVER_STORE_OCI_LOCAL_DIR=/data/oci
DIRECTORY_SERVER_STORE_OCI_REPOSITORY_NAME=dir

# Routing (libp2p) cannot be switched off in v1.8.0. Keep it alone: no bootstrap
# peer, loopback listener, no GossipSub, no automatic sync, no relay.
DIRECTORY_SERVER_ROUTING_LISTEN_ADDRESS=/ip4/127.0.0.1/tcp/8999
DIRECTORY_SERVER_ROUTING_BOOTSTRAP_PEERS=
DIRECTORY_SERVER_ROUTING_GOSSIPSUB_ENABLED=false
DIRECTORY_SERVER_ROUTING_AUTOSYNC_ENABLED=false
DIRECTORY_SERVER_ROUTING_RELAY_SERVICE=false

DIRECTORY_SERVER_METRICS_ENABLED=false
DIRECTORY_SERVER_HTTP_GATEWAY_ENABLED=false
DIRECTORY_SERVER_RATELIMIT_ENABLED=false
