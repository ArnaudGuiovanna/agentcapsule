[Unit]
ConditionPathExists=!/var/lib/agentcapsule-install/maintenance
Description=AgentCapsule member identity provider
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
StateDirectory=agentcapsule-oidc
StateDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -I /usr/local/lib/agentcapsule-host/oidc-container.py prepare
EnvironmentFile=/etc/agentcapsule/oidc.env
ExecStart=/usr/bin/podman run --rm --cidfile=/var/lib/agentcapsule-oidc/container-id --name agentcapsule-oidc --pull=never --network=host --cap-drop=all --security-opt=no-new-privileges --env-file=/etc/agentcapsule/oidc.env -v /etc/agentcapsule/oidc/realm.json:/opt/keycloak/data/import/realm.json:ro -v /etc/agentcapsule/oidc-tls:/keycloak-tls:ro quay.io/keycloak/keycloak@sha256:7e66a96e4739239070aeaf72e4c5decf0f7f682cfc725b9f7ea2b336eaba38b3 start --import-realm
ExecStop=/usr/bin/python3 -I /usr/local/lib/agentcapsule-host/oidc-container.py stop
ExecStopPost=/usr/bin/python3 -I /usr/local/lib/agentcapsule-host/oidc-container.py cleanup
Restart=on-failure
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
