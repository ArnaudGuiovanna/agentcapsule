# Install as /usr/lib/tmpfiles.d/agentcapsule-slim.conf (systemd-tmpfiles).
# One directory per side of the local SLIM link, created at boot, before the
# worker or the bridge starts. Each side creates its socket in its own
# directory, which the other side can only traverse, so neither can remove
# or replace the other's socket. Each directory is set-group-ID to the other
# side's group: a socket gets that group, mode 0660, without a chown, since
# neither side is root (ADR 024); each side also checks its peer's UID.
d /run/agentcapsule-slim   2750 agentcapsule-slim   agentcapsule-worker -
d /run/agentcapsule-worker 2710 agentcapsule-worker agentcapsule-slim   -
