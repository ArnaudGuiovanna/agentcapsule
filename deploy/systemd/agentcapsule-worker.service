[Unit]
Description=AgentCapsule Firecracker worker
After=network-online.target postgresql.service agentcapsule-authority.service agentcapsule-interop.service agentcapsule-worker-helper.service
Wants=network-online.target agentcapsule-authority.service agentcapsule-interop.service agentcapsule-worker-helper.service
ConditionPathExists=!/var/lib/agentcapsule-install/maintenance

[Service]
Type=exec
EnvironmentFile=/etc/agentcapsule/worker.env
ExecStart=/opt/agentcapsule/agentcapsule-worker -config /etc/agentcapsule/worker.json
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0

# Privilege separation (A-03, docs/adr/024-worker-privilege-separation.md,
# docs/worker.md#privilege-separation). The worker runs as its own account,
# with no capability: what needs root (the jailer, the VMs' cgroups and
# jails, the files of the VMs' UIDs, /proc of their VMMs, the confined
# inspections, the archive fetch) goes to agentcapsule-worker-helper, over
# its socket. The VMMs run in their own cgroups, children of the helper,
# never of this unit: restarting it stops no VM, so systemd's default
# KillMode applies and Delegate is not needed.
User=agentcapsule-worker
Group=agentcapsule-worker
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Writes: the runtime root (the registry and host.lock, the per-agent
# locks/, the admission/ queue, the boot credentials, the VMM logs, the
# cached kernels and initrds of bin/, the volumes' files and journals, the
# registry's and the corpora's caches), the archives, the restore tests'
# scratch, and the SLIM socket's directory. The installer creates them, the
# worker's; a root, an archive root, a cache or a trace_file elsewhere needs
# a drop-in with ReadWritePaths=. No StateDirectory=: systemd would give a
# state directory it finds of another owner, recursively, to this unit's
# user, the VMs' volumes included.
ProtectSystem=strict
ReadWritePaths=-/var/lib/agentcapsule/host -/var/lib/agentcapsule-archives -/var/lib/agentcapsule-restore-tests -/run/agentcapsule-worker
# The worker reaches the authorities through their service only.
InaccessiblePaths=-/var/lib/agentcapsule-key-authority -/var/lib/agentcapsule-restore-authority -/var/lib/agentcapsule-authority-replica
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# AF_ALG: libcryptsetup formats a new volume's LUKS2 key slot with the
# kernel's crypto API (a regular file needs no device). AF_NETLINK: glibc's
# resolver, which Go uses in this cgo binary when nsswitch.conf names more
# than files and dns.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_ALG
# Left out, and why:
# - ProcSubset: provisioning reads /proc/meminfo for the deployment budget.
# - PrivateNetwork, IPAddressDeny: the worker calls registries, forges, model
#   providers and the Directory.
# - PrivateUsers: PostgreSQL's peer authentication and the authority
#   service's and the helper's peer checks read this account's real UID.
# - MemoryMax: the worker streams its downloads and archive copies; its
#   ceiling is not measured yet. The VMs' limits are the helper's (ADR 012).

[Install]
WantedBy=multi-user.target
