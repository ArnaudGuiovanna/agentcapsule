# The standby's replay for node_exporter's textfile collector (REC-03): whether
# PostgreSQL is in recovery, and the commit time of the last transaction it
# replayed. On the standby host only. It runs as root only to write into
# node_exporter's directory; psql runs as postgres, over the local socket.
# Started every minute by agentcapsule-standby-metrics.timer.
[Unit]
Description=Agent Capsule standby replay for node_exporter

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/agentcapsule/agentcapsule-standby-metrics.py --textfile-directory=/var/lib/prometheus/node-exporter
TimeoutStartSec=2min
# Every minute: only failures reach the journal. The script writes only
# failures, and they are logged as warnings; "Starting" and "Finished" are not.
SyslogLevel=warning
LogLevelMax=notice
# Switch to postgres for psql, and write into a directory node_exporter owns.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
