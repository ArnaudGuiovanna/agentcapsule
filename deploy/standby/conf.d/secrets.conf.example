# /etc/pgbackrest/conf.d/secrets.conf on the standby host, owned by postgres,
# mode 0600. The repository numbers are not the primary's: here the local copy
# comes first, so the two passphrases swap places.
[global]
# The primary's repo2-cipher-pass: the SFTP repository, read on this disk.
repo1-cipher-pass=<the primary's repo2-cipher-pass>
# A credential of its own, that can only read and list the bucket.
repo2-s3-key=<access key of a read-only, bucket-scoped credential>
repo2-s3-key-secret=<its secret>
# The primary's repo1-cipher-pass.
repo2-cipher-pass=<the primary's repo1-cipher-pass>
